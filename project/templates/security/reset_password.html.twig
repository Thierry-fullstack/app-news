{% extends 'base.html.twig' %}

{% block title %}Réinitialisation de mot de passe{% endblock %}

{% block body %}
<section class="container-sm my-3">
    <div class="row">
        <div class="col-10">
            <h1>Réinitialisation de mot de passe</h1>
            {{ form_start(passForm) }}
                {{ form_row(passForm.plainPassword) }}
                <button type="submit" class="btn btn-outline-warning text-primary-emphasis text-capitalize w-100">Envoyer</button>
            {{ form_end(passForm) }}
        </div>
    </div>
</section>

{% endblock %}
