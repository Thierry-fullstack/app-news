
{% if identity is defined %}
<div class="container-sm">
<div class="alert alert-dismissible alert-light">
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    <div class="alert-message fw-lighter text-center" >
        <strong>Enregistrement réussi !</strong> Vous pouvez accédez à votre profil en cliquant sur le lien :
        <a href="{{ path('app_main') }}" class="alert-link">{{ app.user.email }}</a>
    </div>
</div>
</div>
{% endif %}

