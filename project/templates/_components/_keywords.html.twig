<div class="card mb-4">
    <div class="card-header fst-italic color-wine">Mots-clés</div>
    <div class="card-body">
        <div class="row">
            {% for keyword in keywords %}
                <div class="col-4 col-sm-6">
                    <ul class="list-unstyled mb-0">
                        {% if loop.index is divisible by(2) %}
                        <li class="mb-1">
                            <span class="badge  rounded-pill bg-dark-subtle">
                                <a href="{{ path('app_main_show_posts_keyword',{id:keyword.id}) }}" class="color-wine fw-bolder text-decoration-none">{{ keyword.name }}</a>
                            </span>
                        </li>
                        {% else %}
                        <li class="mb-1"><span class="badge  rounded-pill bg-dark-subtle"><a href="{{ path('app_main_show_posts_keyword',{id:keyword.id}) }}" class="text-dark text-decoration-none">{{ keyword.name }}</a></span></li>
                         {% endif %}
                    </ul>
                </div>
            {% endfor %}
        </div>
    </div>
</div>


