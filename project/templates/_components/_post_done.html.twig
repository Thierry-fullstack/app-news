
{% if article is defined %}
<div class="container-sm">
<div class="alert alert-dismissible alert-success">
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    <div class="alert-message fw-lighter text-center" >
        <strong>Enregistrement réussi !</strong> Accédez à votre profil en cliquant sur le lien :
        <a href="{{ path('profile_app_identity_user') }}" class="alert-link">{{ app.user.email }}</a>
    </div>
</div>
</div>
{% endif %}

